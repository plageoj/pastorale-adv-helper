{
  "name": "admin",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch --no-progress --coverage",
    "lint": "ng lint",
    "stats": "ng build --stats-json",
    "analyze": "ng build -c production --source-map && source-map-explorer dist/*.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.24",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.24",
    "@angular/compiler": "^21.2.24",
    "@angular/core": "^21.2.24",
    "@angular/fire": "^21.0.0-rc.1",
    "@angular/forms": "^21.2.24",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.24",
    "@angular/platform-browser-dynamic": "^21.2.24",
    "@angular/router": "^21.2.24",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.24",
    "@types/node": "^24.19.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "jasmine-marbles": "^0.9.2",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.0",
    "source-map-explorer": "^2.5.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint"
    ]
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true,
    "protobufjs@7.6.6": true
  }
}
